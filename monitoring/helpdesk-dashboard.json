    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "{namespace=\"$namespace\"} |= \"\\\"logger\\\": \\\"security\\\"\"",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "options": {
